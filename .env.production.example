# Root-level env file for docker-compose.production.yml. Docker Compose
# auto-loads a file named exactly ".env" sitting next to the compose file
# for variable substitution (the ${VAR} references inside the compose
# file) - copy this to ".env" (not "backend/.env.production" - that's a
# different, separate file) and fill in every REPLACE_WITH_* value.
#
# This is the ONE place database credentials live. docker-compose.production.yml
# injects these same values into both the mysql container (as
# MYSQL_*) and the api container (as DB_*), overriding whatever
# backend/.env.production says for DB_HOST/DB_NAME/DB_USER/DB_PASSWORD -
# so you never have to keep two copies of the same password in sync.

DOMAIN=api.budget254.co.ke
ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL@budget254.co.ke

DB_NAME=budget254_paye
DB_USER=budget254
# Generate with: openssl rand -hex 24
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
