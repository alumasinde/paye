# Production environment template.
#
# These are the ONLY variables internal/config.Load() actually reads (see
# internal/config/config.go). The previous version of this file used a
# MYSQL_DSN / RATE_LIMIT_PER_MINUTE / TRUST_PROXY scheme left over from an
# unused parallel config package that was never wired into the running
# server - deploying with those variables would have silently misconfigured
# production (no rate limiting, default CORS, default timeouts) with no
# error, because the live app never read them. Copy this file to .env (or
# set these as real environment variables in your deploy platform) and fill
# in every REPLACE_WITH_* value.

APP_ENV=production
APP_VERSION=1.0.0

HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
# 1 MiB. Raise only if you have a real endpoint that needs larger bodies.
HTTP_MAX_REQUEST_BODY_BYTES=1048576
# true only when the API sits behind a trusted reverse proxy/load balancer
# that sets X-Forwarded-For itself (nginx, Cloudflare, a cloud LB). If the
# API is reachable directly from the internet, leave this false - otherwise
# a client can spoof X-Forwarded-For and defeat rate limiting entirely.
HTTP_TRUST_PROXY_HEADERS=true

DB_HOST=REPLACE_WITH_DB_HOST
DB_PORT=3306
DB_NAME=budget254_paye
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_TLS=false
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m
DB_CONNECT_TIMEOUT=5s
# ^ DB_HOST/DB_NAME/DB_USER/DB_PASSWORD above are only used if you deploy
# this file's values as-is. If you deploy with docker-compose.production.yml
# (the documented path - see DEPLOY.md), those four keys are overridden
# at container-start time from the root .env file instead (DB_HOST becomes
# "mysql", the Compose service name), so the database password only has
# to be set in one place. DB_TLS should be false for that path too, since
# traffic to the mysql container never leaves the Docker network - only
# set DB_TLS=true if DB_HOST points at a database outside this Docker
# network (a managed DB, a different host).

# Comma-separated, no spaces needed. Only these origins can call the API
# from a browser (the Android app doesn't send an Origin header, so this
# doesn't affect it).
CORS_ALLOWED_ORIGINS=https://admin.budget254.co.ke,https://budget254.co.ke
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_MAX_AGE_SECONDS=600
# Production must use only explicit origins above.
CORS_ALLOW_PRIVATE_NETWORK_ORIGINS=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX_CLIENTS=10000

LOG_LEVEL=INFO

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
AUTH_MAX_FAILED_REQUESTS=10
